# Server Configuration
PORT=5000
HOST=localhost
NODE_ENV=development
API_VERSION=v1
BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/zoharix-pay-tickets

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=default
CLOUDINARY_FOLDER=zoharix-pay-tickets

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_SKIP_IPS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=logs/app.log
ENABLE_CONSOLE_LOGGING=true
LOG_MAX_FILE_SIZE=10485760
LOG_MAX_FILES=5